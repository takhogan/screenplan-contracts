{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screenplan.local/schemas/script-action.schema.json",
  "title": "ScriptAction",
  "description": "A single ScriptAction node as authored in script-studio and consumed by ScriptEngine. The shape of `actionData` is discriminated on `actionName`; per-subtype payloads are defined in script-action-data.schema.json.",
  "type": "object",
  "required": [
    "actionName",
    "actionData",
    "actionGroup",
    "actionVersion",
    "actionVersionCode",
    "actionLabel",
    "actionRowRowIndex",
    "actionRowActionIndex",
    "visualizerRowIndex",
    "visualizerActionIndex",
    "visualizerX",
    "visualizerY",
    "childGroups",
    "parentGroups",
    "displayables",
    "configurables",
    "linkingBehaviors"
  ],
  "additionalProperties": true,
  "properties": {
    "actionName": {
      "type": "string",
      "description": "Discriminator for the ScriptAction subtype. Note: searchPatternStartAction / searchPatternContinueAction / searchPatternEndAction are deprecated — retained for loading legacy scripts; do not author new uses.",
      "enum": [
        "jointAction",
        "clickAction",
        "mouseScrollAction",
        "declareScene",
        "conditionalStatement",
        "shellScript",
        "logAction",
        "sleepStatement",
        "variableAssignment",
        "timeAction",
        "randomVariable",
        "scriptReference",
        "dragLocationSource",
        "dragLocationTarget",
        "detectObject",
        "keyboardAction",
        "searchPatternStartAction",
        "searchPatternContinueAction",
        "searchPatternEndAction",
        "randomizerAction",
        "jsonFileAction",
        "exceptionAction",
        "navigateAction",
        "ImageToTextAction",
        "imageToTextAction",
        "scale",
        "sendMessageAction",
        "codeBlock",
        "forLoopAction",
        "configurationAction",
        "ADBConfigurationAction",
        "colorCompareAction",
        "returnStatement",
        "imageTransformationAction",
        "countToThresholdAction",
        "fileIOAction",
        "maskMergeAction",
        "mouseMoveAction",
        "mouseInteractionAction",
        "userPromptAction",
        "calendarAction",
        "userSecretManagementAction",
        "interactApplicationAction"
      ]
    },
    "actionIcon": {
      "description": "UI-only: icon descriptor (one of imageIcon|symbolIcon|svgIcon|textIcon|customIcon|blankIcon|gridIcon). Image references are persisted as relative paths or null.",
      "type": ["object", "string", "null"]
    },
    "actionData": {
      "type": "object",
      "description": "Per-actionName payload. Structure is selected by the oneOf below using actionName as discriminator.",
      "additionalProperties": true
    },
    "actionGroup": { "type": "integer" },
    "actionGroups": {
      "type": "array",
      "items": { "type": "integer" },
      "description": "Only used by jointAction."
    },
    "actionVersion": { "type": "integer" },
    "actionVersionCode": { "type": "string" },
    "actionLabel": { "type": "string" },
    "actionRowRowIndex": { "type": "integer" },
    "actionRowActionIndex": { "type": "integer" },
    "visualizerRowIndex": { "type": "integer" },
    "visualizerActionIndex": { "type": "integer" },
    "visualizerX": { "type": "number" },
    "visualizerY": { "type": "number" },
    "childGroups": {
      "type": "array",
      "description": "ActionLink array; concrete shape varies by branchingBehavior.",
      "items": { "type": "object", "additionalProperties": true }
    },
    "parentGroups": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "displayables": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "configurables": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "linkingBehaviors": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "actionAssets": {
      "description": "Per-action registry of files persisted under `assets/` (flat layout, since interfaceVersion 21). Each entry locates a file and the dot-path on the action where the loaded value should be placed at deserialise time.",
      "type": "array",
      "items": { "$ref": "#/$defs/ScriptActionAsset" }
    },
    "selected": { "type": "boolean" },
    "draggable": { "type": "boolean" },
    "highlight": { "type": "string" },
    "helpTipExpanded": { "type": "boolean" }
  },
  "$defs": {
    "ScriptActionAsset": {
      "type": "object",
      "description": "One persisted asset belonging to a ScriptAction. The flat `assets/` folder layout uses `filePath` to locate the file. `attributePath` is the dot-path within the action where the loaded value should be placed (numeric segments traverse arrays). `md5` is the hash of the file's bytes; populated when the asset is first registered (e.g. via `ScriptFlatAssetsUtils.addActionAsset`).",
      "required": ["filePath", "attributePath", "assetType", "md5"],
      "additionalProperties": true,
      "properties": {
        "filePath": {
          "type": "string",
          "description": "Path relative to the script root, e.g. `assets/{md5}-{actionName}-{actionGroup}-{specificFileName}.{ext}`."
        },
        "attributePath": {
          "type": "string",
          "description": "Dot-path within the ScriptAction where the loaded value lives (e.g. `actionData.srcImg`, `actionData.positiveExamples.0.floatingObject.img`, `actionIcon.icon`, `actionIcon.grid.0.0.icon`)."
        },
        "assetType": {
          "type": "string",
          "enum": ["image", "json", "pointList", "text"],
          "description": "Selects the loader: `image` => binary decoded with the platform's image library; `json`/`pointList` => `JSON.parse`; `text` => raw UTF-8."
        },
        "md5": {
          "type": "string",
          "description": "Hex MD5 of the file's bytes."
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "actionName": { "const": "jointAction"             } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/JointActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "clickAction"             } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ClickActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "mouseScrollAction"       } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/MouseScrollActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "declareScene"            } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/DeclareSceneData" } } } },
    { "if": { "properties": { "actionName": { "const": "conditionalStatement"    } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ConditionalStatementData" } } } },
    { "if": { "properties": { "actionName": { "const": "shellScript"             } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ShellScriptActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "logAction"               } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/LogActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "sleepStatement"          } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/SleepStatementData" } } } },
    { "if": { "properties": { "actionName": { "const": "variableAssignment"      } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/VariableAssignmentData" } } } },
    { "if": { "properties": { "actionName": { "const": "timeAction"              } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/TimeActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "randomVariable"          } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/RandomVariableData" } } } },
    { "if": { "properties": { "actionName": { "const": "scriptReference"         } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ScriptReferenceData" } } } },
    { "if": { "properties": { "actionName": { "const": "dragLocationSource"      } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/DragLocationData" } } } },
    { "if": { "properties": { "actionName": { "const": "dragLocationTarget"      } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/DragLocationData" } } } },
    { "if": { "properties": { "actionName": { "const": "detectObject"            } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/DetectObjectData" } } } },
    { "if": { "properties": { "actionName": { "const": "keyboardAction"          } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/KeyboardActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "searchPatternStartAction"} } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/SearchPatternStartActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "searchPatternContinueAction" } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/SearchPatternContinueActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "searchPatternEndAction"  } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/SearchPatternEndActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "randomizerAction"        } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/RandomizerActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "jsonFileAction"          } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/JSONFileActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "exceptionAction"         } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ExceptionActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "navigateAction"          } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/NavigateActionData" } } } },
    { "if": { "properties": { "actionName": { "enum": ["ImageToTextAction", "imageToTextAction"] } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ImageToTextActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "scale"                   } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ScaleData" } } } },
    { "if": { "properties": { "actionName": { "const": "sendMessageAction"       } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/SendMessageActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "codeBlock"               } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/CodeBlockActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "forLoopAction"           } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ForLoopActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "configurationAction"     } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ConfigurationActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "ADBConfigurationAction"  } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ADBConfigurationData" } } } },
    { "if": { "properties": { "actionName": { "const": "colorCompareAction"      } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ColorCompareActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "returnStatement"         } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ReturnStatementActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "imageTransformationAction" } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/ImageTransformationActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "countToThresholdAction"  } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/CountToThresholdActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "fileIOAction"            } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/FileIOActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "maskMergeAction"         } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/MaskMergeActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "mouseMoveAction"         } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/MouseMoveActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "mouseInteractionAction"  } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/MouseInteractionActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "userPromptAction"        } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/UserPromptActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "calendarAction"          } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/CalendarActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "userSecretManagementAction" } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/UserSecretManagementActionData" } } } },
    { "if": { "properties": { "actionName": { "const": "interactApplicationAction" } } }, "then": { "properties": { "actionData": { "$ref": "script-action-data.schema.json#/$defs/InteractApplicationActionData" } } } }
  ]
}
